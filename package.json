{
	"name": "@cldmv/lib-process",
	"version": "0.1.1",
	"description": "Process safety for Node: liveness checks a crash can't leave stale, locks that release when their holder dies, and kills that only ever reach your own processes.",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"exports": {
		".": {
			"lib-process-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/"
	],
	"scripts": {
		"build": "tsup",
		"build:ci": "npm run lint && npm run format:check && npm run types:check && npm run types:build && npm run build",
		"prepack": "npm run build",
		"types:build": "tsc -p .configs/tsconfig.json --noCheck",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"test": "node tests/run-vitest.mjs && npm run test:cjs && npm run test:dist",
		"test:cjs": "npm run build && node --conditions=lib-process-dev --test tests/cjs/entry.test.cjs",
		"test:dist": "npm run build && node tests/run-vitest.mjs --mode=dist",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage && npm run test:cjs && npm run test:dist",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"keywords": [
		"process",
		"pid",
		"liveness",
		"lock",
		"lockfile",
		"kill",
		"unix-socket"
	],
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/lib-process.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/lib-process/issues"
	},
	"homepage": "https://github.com/CLDMV/lib-process#readme",
	"devDependencies": {
		"@cldmv/configs": "^1.4.0",
		"@cldmv/eslint-plugin-jsonv": "^1.1.2",
		"@cldmv/fix-headers": "^2.2.7",
		"@cldmv/jsonv": "^1.2.2",
		"@cldmv/prettier-plugin-jsonv": "^1.2.2",
		"@cldmv/vitest-runner": "^1.11.3",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^9.0.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.1"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	}
}
